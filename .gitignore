# Nested clone for local dev (separate git repo)
AIagent/

# Local AI connection (contains API token) — never commit
**/hiatme_ai.defaults.json
**/hiatme_ai.json
**/hiatme_config/gmail_default.json

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/

# Release tooling lives under "release/" — explicitly whitelist it back in.
# The big .zip payloads still stay out (they belong in the website repo, not here).
!Hiatme Tool Suite v3/release/
Hiatme Tool Suite v3/release/*.zip

# Snapshot folders used to test the updater pipeline end-to-end.
__test_run_*/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild/
[Oo]ut/

# NuGet
packages/
*.nupkg
*.snupkg
.nuget/

# Node
node_modules/
Server/node_modules/

# Local OSRM map data (large; build via tools/osrm/scripts)
tools/osrm/data/

# Python helper scripts
**/__pycache__/
scripts/__pycache__/
*.pyc

# Misc
*.log
*.cache
*.pdb
*.exe
Thumbs.db

# Local editor / tooling (empty dirs Cursor shows as untracked)
.cursor/
.tools/

# Empty local test project folder (not part of the solution)
Hiatme Tool Suite v3/Hiatme.ToolSuite.WellRyde.Tests/
